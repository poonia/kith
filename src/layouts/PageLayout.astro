---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { ogImagePath } from '@/lib/og';
import { personLd } from '@/lib/seo';

interface Props {
  id: string;
  title: string;
  description: string;
  updatedDate?: Date;
  draft?: boolean;
}
const { id, title, description, updatedDate, draft = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={draft}
  image={ogImagePath('pages', id)}
  jsonLd={id === 'about' ? { '@type': 'ProfilePage', mainEntity: personLd(Astro.site) } : undefined}
>
  <article class="container page" data-pagefind-body>
    <header>
      {draft && <p class="draft" data-pagefind-ignore>Draft — not visible in production</p>}
      <h1>{title}</h1>
      {
        updatedDate && (
          <p class="muted updated" data-pagefind-ignore>
            Last updated <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  header {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
  }
  .updated {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }
  .draft {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }
</style>
