---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { CF_ANALYTICS_TOKEN, SITE } from '@/consts';

import type { Props as HeadProps } from '@/components/BaseHead.astro';
type Props = HeadProps;
const props = Astro.props;
const analytics = import.meta.env.PROD && CF_ANALYTICS_TOKEN ? JSON.stringify({ token: CF_ANALYTICS_TOKEN }) : null;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {analytics && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={analytics} />
    )}
  </body>
</html>
