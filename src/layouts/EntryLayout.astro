---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import TagList from '@/components/TagList.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import PrevNext from '@/components/PrevNext.astro';
import Comments from '@/components/Comments.astro';
import { resolveImage } from '@/lib/images';
import { entryHref, type AnyEntry } from '@/lib/tags';
import { ogImagePath } from '@/lib/og';
import { absolute, personLd } from '@/lib/seo';
import katexCss from 'katex/dist/katex.min.css?url';

interface Props {
  entry: AnyEntry;
  headings: MarkdownHeading[];
  readingTime?: number;
  /** Load KaTeX CSS only on entries that contain maths. */
  hasMath?: boolean;
  newer?: AnyEntry;
  older?: AnyEntry;
}

const { entry, headings, readingTime, hasMath = false, newer, older } = Astro.props;
const { title, description, pubDate, tags, draft } = entry.data;
const isBlog = entry.collection === 'blog';
const updatedDate = 'updatedDate' in entry.data ? entry.data.updatedDate : undefined;
const canonical = 'canonical' in entry.data ? entry.data.canonical : undefined;
const hero = 'heroImage' in entry.data ? resolveImage(entry.data.heroImage) : undefined;
const heroAlt = 'heroAlt' in entry.data ? entry.data.heroAlt : undefined;
const showComments = 'comments' in entry.data ? entry.data.comments : true;
const source = 'source' in entry.data ? entry.data.source : undefined;

const url = absolute(entryHref(entry), Astro.site);
const image = ogImagePath(entry.collection, entry.id);
const jsonLd = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: personLd(Astro.site),
  publisher: personLd(Astro.site),
  image: absolute(image, Astro.site),
  keywords: tags.join(', ') || undefined,
  inLanguage: 'en',
  ...(readingTime ? { timeRequired: `PT${readingTime}M` } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={draft}
  type="article"
  image={image}
  article={{ published: pubDate, modified: updatedDate, tags }}
  jsonLd={jsonLd}
>
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <div class="container entry">
    <article class="entry-main" data-pagefind-body>
      <header class="entry-header">
        {draft && (
          <p class="draft" data-pagefind-ignore>
            Draft — not visible in production
          </p>
        )}
        {!isBlog && (
          <p class="kicker" data-pagefind-ignore>
            <a href="/snippets/">Snippet</a>
          </p>
        )}
        <h1 data-pagefind-meta="title">{title}</h1>
        <div class="meta" data-pagefind-ignore>
          <FormattedDate date={pubDate} />
          {readingTime && <span>{readingTime} min read</span>}
          {updatedDate && (
            <span class="updated">
              Updated <FormattedDate date={updatedDate} />
            </span>
          )}
        </div>
        {tags.length > 0 && (
          <div class="entry-tags" data-pagefind-ignore>
            <TagList tags={tags} />
          </div>
        )}
        <meta data-pagefind-meta="date[content]" content={pubDate.toISOString().slice(0, 10)} />
      </header>

      {hero && (
        <Image
          class="hero"
          src={hero}
          alt={heroAlt ?? ''}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 72rem) 68ch, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )}

      <div class="toc-mobile" data-pagefind-ignore>
        <TableOfContents headings={headings} variant="inline" />
      </div>

      <div class="prose">
        <slot />
      </div>

      {source && (
        <p class="source" data-pagefind-ignore>
          Source: <a href={source}>{new URL(source).hostname}</a>
        </p>
      )}
    </article>

    <aside class="entry-aside" data-pagefind-ignore>
      <TableOfContents headings={headings} variant="sidebar" />
    </aside>

    <div class="entry-footer" data-pagefind-ignore>
      <PrevNext newer={newer} older={older} />
      {showComments && !draft && <Comments />}
    </div>
  </div>
</BaseLayout>

<script>
  import mediumZoom from 'medium-zoom';
  // Click-to-zoom for content images (skip linked images and diagrams).
  const zoomable = [...document.querySelectorAll<HTMLImageElement>('.prose img')].filter(
    (img) => !img.closest('a, .diagram, .no-zoom'),
  );
  if (zoomable.length) mediumZoom(zoomable, { margin: 24, background: 'var(--color-bg)' });
</script>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--space-12);
  }
  .entry-aside {
    display: none;
  }
  @media (min-width: 68rem) {
    .entry {
      grid-template-columns: minmax(0, var(--measure)) 14rem;
      column-gap: var(--space-16);
      justify-content: space-between;
    }
    .entry-main {
      grid-column: 1;
    }
    .entry-aside {
      display: block;
      grid-column: 2;
      grid-row: 1 / span 2;
      padding-top: 10rem;
    }
    .entry-footer {
      grid-column: 1;
    }
    .toc-mobile {
      display: none;
    }
  }

  .entry-header {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .meta > :global(* + *)::before {
    content: '·';
    margin-inline-end: var(--space-2);
    color: var(--color-text-subtle);
  }
  .entry-tags {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .kicker {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kicker a {
    text-decoration: none;
  }
  .draft {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }
  .hero {
    width: 100%;
    max-width: var(--measure);
    margin-bottom: var(--space-8);
    border-radius: var(--radius-md);
  }
  .source {
    max-width: var(--measure);
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
